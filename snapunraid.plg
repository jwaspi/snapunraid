<?xml version="1.0"?>
<!DOCTYPE PLUGIN [
  <!ENTITY name      "snapunraid">
  <!ENTITY author    "jwaspi">
  <!ENTITY version   "2026.09.08">
  <!ENTITY launch    "Settings/snapunraid">
  <!ENTITY pluginURL "https://raw.githubusercontent.com/jwaspi/snapunraid/main/snapunraid.plg">
  <!ENTITY support   "https://github.com/jwaspi/snapunraid/issues">
]>
<PLUGIN name="snapunraid" version="&version;" author="&author;" icon="camera"
        pluginURL="&pluginURL;" support="&support;" launch="&launch;">
  <CHANGES><![CDATA[
2026.09.08 - FIX: the cron entries included a "root" user column, but Unraid crond parses /etc/cron.d files in the plain 5-field format and executed "root bash ..." as a command - every scheduled sync/scrub/health-check silently failed with exit 127 since install. Entries are now 5-field like Unraid own cron files.
2026.09.06 - FIX: cron-driven runs (nightly sync, Sunday scrub, 3:15am health check) aborted instantly with "snapraid binary not found" because crond's minimal PATH does not include /usr/local/sbin, where the snapraid binary lives; common.sh now adds it to PATH.
2026.09.05 - initial public release. SnapRAID webGUI for Unraid: Setup (parity + optional second parity, data disks, excludes, schedule, safety threshold), Dashboard with live sync/scrub progress, Recover (per-file/disk/all restore + full check), History, Alerts, and config Backup/Import.
  ]]>
  </CHANGES>

  <RUN command="rm -rf /usr/local/emhttp/plugins/snapunraid"/>
  <RUN command="mkdir -p /usr/local/emhttp/plugins/snapunraid/scripts"/>
  <RUN command="mkdir -p /usr/local/emhttp/plugins/snapunraid/images"/>

  <FILE Name="/usr/local/emhttp/plugins/snapunraid/snapunraid.page">
  <INLINE>
<![CDATA[Menu="Utilities"
Title="SnapUnraid"
Icon="camera"
---
<?php
/*
 * SnapUnraid - friendly front-end for SnapRAID on Unraid
 * Tabs: Setup / Dashboard / Recover
 *
 * NOTE: AJAX/POST handling does NOT live here. Unraid's nginx returns 405
 * Not Allowed for POST to .page files, so all front-end post() requests go to
 * /plugins/snapunraid/ajax.php. This file only renders the page HTML.
 */

$plugin      = 'snapunraid';
$scriptDir   = '/usr/local/emhttp/plugins/' . $plugin . '/scripts';
$settingsIni = '/boot/config/plugins/' . $plugin . '/settings.ini';
// ---------------------------------------------------------------------------
// Load current settings for pre-filling the Setup form
// ---------------------------------------------------------------------------
function sre_ini_get($key, $default = '') {
    global $settingsIni;
    if (!file_exists($settingsIni)) return $default;
    foreach (file($settingsIni) as $line) {
        if (strpos($line, "{$key}=") === 0) {
            return trim(substr($line, strlen($key) + 1));
        }
    }
    return $default;
}

$cur_parity   = sre_ini_get('PARITY_PATH', '');
$cur_data     = sre_ini_get('DATA_DISKS', '');
$cur_content  = sre_ini_get('CONTENT_DISKS', '');
$cur_excludes = sre_ini_get('EXCLUDES', '*.tmp,*.bak,/appdata/,/system/,/domains/,/isos/,downloads/incomplete/');
$cur_schedule = sre_ini_get('SCHEDULE', 'daily');
$cur_custom_sync = sre_ini_get('CUSTOM_SYNC_CRON', '30 3 * * 1,3,5');
$cur_custom_scrub = sre_ini_get('CUSTOM_SCRUB_CRON', '0 4 * * 0');
$cur_threshold= sre_ini_get('DELETE_THRESHOLD_COUNT', '50');
$alertDefaults = [
    'ALERT_SYNC_OK' => '0', 'ALERT_SYNC_ERROR' => '1', 'ALERT_SYNC_CONFIRM' => '1',
    'ALERT_SCRUB_OK' => '0', 'ALERT_SCRUB_ISSUES' => '1',
    'ALERT_RECOVER_OK' => '0', 'ALERT_RECOVER_ERROR' => '1', 'ALERT_CANCELLED' => '0',
    'ALERT_PARITY_STALE' => '1', 'ALERT_DISK_OFFLINE' => '1',
    'ALERT_PARITY_SPACE' => '1', 'ALERT_SCRUB_OVERDUE' => '1',
    'ALERT_CONTENT_STALE' => '1', 'ALERT_PARITY_MISSING' => '1', 'ALERT_UNRECOVERED' => '1',
    'ALERT_PARITY_STALE_DAYS' => '30', 'ALERT_PARITY_SPACE_PCT' => '10', 'ALERT_SCRUB_OVERDUE_DAYS' => '30',
];
$cur_alerts = [];
foreach ($alertDefaults as $k => $def) { $cur_alerts[$k] = sre_ini_get($k, $def); }
$is_configured = !empty($cur_parity) && !empty($cur_data);

// Auto-detect an existing snapraid.conf (from the old snapraid plugin, a
// manual /etc install, etc.) so the Setup tab can offer to import it.
$importCandidates = [
    '/boot/config/plugins/snapraid/snapraid.conf',
    '/etc/snapraid.conf',
    '/boot/config/snapraid.conf',
];
$importDetected = '';
foreach ($importCandidates as $c) { if (file_exists($c)) { $importDetected = $c; break; } }
?>

<link rel="stylesheet" href="/plugins/<?=$plugin?>/snapunraid.css">

<div class="sre-wrap">
  <div class="sre-tabs">
    <button class="sre-tab-btn active" data-tab="dashboard">Dashboard</button>
    <button class="sre-tab-btn" data-tab="setup">Setup</button>
    <button class="sre-tab-btn" data-tab="history">History</button>
    <button class="sre-tab-btn" data-tab="recover" id="sre-recover-tab-btn">Recover</button>
    <button class="sre-tab-btn" data-tab="alerts">Alerts</button>
    <button class="sre-tab-btn" data-tab="backup">Backup/Import</button>
  </div>

  <!-- Help tooltip (Sync vs Scrub explainer). Populated by JS; shown on click. -->
  <div id="sre-help-tooltip" class="sre-tooltip"></div>

  <!-- ============================ DASHBOARD ============================ -->
  <div class="sre-tab-panel" id="tab-dashboard">
    <?php if (!$is_configured): ?>
      <div class="sre-banner sre-banner-info">
        Not set up yet. Head to the <b>Setup</b> tab to choose your parity disk and protected disks.
      </div>
    <?php else: ?>
      <div class="sre-status-card">
        <div class="sre-status-light" id="sre-status-light">&nbsp;</div>
        <div class="sre-status-text">
          <div class="sre-status-headline" id="sre-status-headline">Loading status&hellip;</div>
          <div class="sre-status-sub" id="sre-status-sub"></div>
          <div class="sre-status-sub" id="sre-array-status"></div>
        </div>
      </div>
      <div id="sre-parity-stale-warning" class="sre-banner sre-banner-warn" style="display:none;"></div>

      <div class="sre-row">
        <div class="sre-card">
          <h3 class="sre-h3-help">Sync
            <span class="sre-help" data-help="sync" title="What is Sync?">&#63;</span>
          </h3>
          <p id="sre-sync-detail">&mdash;</p>
          <button class="sre-btn sre-btn-primary" id="sre-btn-sync">Sync Now</button>
          <button class="sre-btn sre-btn-warn" id="sre-btn-sync-stop" style="display:none;">Cancel Sync</button>
          <div id="sre-sync-confirm" class="sre-confirm" style="display:none;">
            <p></p>
            <button class="sre-btn" id="sre-btn-sync-show-changes" type="button" style="display:none;">Show files to be removed</button>
            <button class="sre-btn sre-btn-warn" id="sre-btn-sync-force">Yes, sync anyway</button>
            <button class="sre-btn" id="sre-btn-sync-cancel">Cancel</button>
          </div>
        </div>
        <div class="sre-card">
          <h3 class="sre-h3-help">Scrub
            <span class="sre-help" data-help="scrub" title="What is Scrub?">&#63;</span>
          </h3>
          <p id="sre-scrub-detail">&mdash;</p>
          <button class="sre-btn sre-btn-primary" id="sre-btn-scrub">Scrub Now</button>
          <button class="sre-btn sre-btn-warn" id="sre-btn-scrub-stop" style="display:none;">Cancel Scrub</button>
        </div>
      </div>

      <div class="sre-card">
        <h3>Recent activity</h3>
        <div id="sre-log-list" class="sre-log-list">Loading&hellip;</div>
      </div>
    <?php endif; ?>
  </div>

  <!-- ============================== SETUP =============================== -->
  <div class="sre-tab-panel" id="tab-setup" style="display:none;">
    <div class="sre-card" id="sre-snapraid-install-card">
      <h3>SnapRAID binary</h3>
      <p class="sre-hint" id="sre-install-detail">Checking whether SnapRAID is installed…</p>
      <button class="sre-btn sre-btn-primary" id="sre-btn-install-snapraid" style="display:none;">Install SnapRAID</button>
    </div>

    <div id="sre-setup-body" style="display:none;">
    <div class="sre-card">
      <h3>1. Parity disk</h3>
      <p class="sre-hint">Pick a mounted disk (array disk or pool) to hold SnapRAID parity. It must be at least as large as your largest protected disk. Raw/unformatted devices aren't supported by SnapRAID — format the disk and add it as a pool first.</p>
      <div id="sre-parity-warning" class="sre-banner sre-banner-warn" style="display:none;">Your current parity disk is a raw device, which SnapRAID doesn't support. Format it and add it as a pool, then select it here.</div>
      <select id="sre-parity-select" class="sre-select"></select>
    </div>

    <div class="sre-card">
      <h3>1b. Second parity disk (optional)</h3>
      <p class="sre-hint">Protects against two simultaneous disk failures. Must be a <b>different</b>, mounted disk at least as large as your largest protected disk. SnapRAID builds the second parity file on the next sync.</p>
      <select id="sre-parity2-select" class="sre-select"></select>
    </div>

    <div class="sre-card">
      <h3>2. Disks to protect</h3>
      <p class="sre-hint">Check every array disk and pool disk you want covered by parity.</p>
      <div id="sre-disk-checklist" class="sre-checklist">Loading disks&hellip;</div>
    </div>

    <div class="sre-card">
      <h3>3. Skip these (optional)</h3>
      <p class="sre-hint">Common junk / active-write locations are pre-checked. Add your own, one per line.</p>
      <div class="sre-checklist" id="sre-exclude-presets">
        <label><input type="checkbox" value="/appdata/" class="sre-exclude-preset" checked> Docker appdata</label>
        <label><input type="checkbox" value="/system/" class="sre-exclude-preset" checked> VM disk images (system share)</label>
        <label><input type="checkbox" value="/domains/" class="sre-exclude-preset" checked> VM domains</label>
        <label><input type="checkbox" value="/isos/" class="sre-exclude-preset" checked> ISOs</label>
        <label><input type="checkbox" value="downloads/incomplete/" class="sre-exclude-preset" checked> In-progress downloads</label>
        <label><input type="checkbox" value="*.tmp" class="sre-exclude-preset" checked> *.tmp files</label>
      </div>
      <textarea id="sre-exclude-custom" class="sre-textarea" placeholder="One extra pattern per line, e.g. *.partial"></textarea>
    </div>

    <div class="sre-card">
      <h3>4. Schedule</h3>
      <select id="sre-schedule-select" class="sre-select">
        <option value="daily">Sync nightly, scrub weekly (recommended)</option>
