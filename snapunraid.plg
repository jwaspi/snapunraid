        <div class="sre-alert-row">
          <label><input type="checkbox" data-alert="ALERT_PARITY_SPACE"> Parity disk low on space</label>
          <span class="sre-disk-size">below <input type="number" class="sre-input sre-alert-num" data-alert="ALERT_PARITY_SPACE_PCT" min="1" max="100">% free</span>
        </div>
        <div class="sre-alert-row">
          <label><input type="checkbox" data-alert="ALERT_SCRUB_OVERDUE"> Scrub is overdue</label>
          <span class="sre-disk-size">oldest file older than <input type="number" class="sre-input sre-alert-num" data-alert="ALERT_SCRUB_OVERDUE_DAYS" min="1" max="365"> days</span>
        </div>
        <div class="sre-alert-row">
          <label><input type="checkbox" data-alert="ALERT_CONTENT_STALE"> A content file is missing or stale</label>
        </div>
        <div class="sre-alert-row">
          <label><input type="checkbox" data-alert="ALERT_PARITY_MISSING"> The parity file is missing</label>
        </div>
        <div class="sre-alert-row">
          <label><input type="checkbox" data-alert="ALERT_UNRECOVERED"> Damaged files are still unrecovered</label>
        </div>
      </div>
    </div>

    <button class="sre-btn sre-btn-primary" id="sre-btn-save-alerts">Save Alerts</button>
    <button class="sre-btn" id="sre-btn-test-notify">Send test notification</button>
    <span id="sre-alerts-result"></span>
  </div>
</div>

<script>
const SRE_AJAX = "/plugins/<?=$plugin?>/ajax.php";
const SRE_CSRF = <?= json_encode($var['csrf_token'] ?? '') ?>;
const SRE_PRESELECTED_DATA = <?= json_encode(array_filter(explode(',', $cur_data))) ?>;
const SRE_PRESELECTED_PARITY = <?= json_encode($cur_parity) ?>;
const SRE_PRESELECTED_PARITY2 = <?= json_encode(sre_ini_get('PARITY2_PATH', '')) ?>;
const SRE_PRESELECTED_SCHEDULE = <?= json_encode($cur_schedule) ?>;
const SRE_CUSTOM_SYNC_CRON = <?= json_encode($cur_custom_sync) ?>;
const SRE_CUSTOM_SCRUB_CRON = <?= json_encode($cur_custom_scrub) ?>;
const SRE_ALERTS = <?= json_encode($cur_alerts) ?>;
const SRE_CUSTOM_EXCLUDES = <?= json_encode(implode("\n", array_diff(
    array_filter(explode(',', $cur_excludes)),
    ['/appdata/', '/system/', '/domains/', '/isos/', 'downloads/incomplete/', '*.tmp']
))) ?>;
</script>
<script src="/plugins/<?=$plugin?>/snapunraid.js"></script>
