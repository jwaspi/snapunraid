  <FILE Name="/usr/local/emhttp/plugins/snapunraid/snapunraid.css">
  <INLINE>
<![CDATA[.sre-wrap { max-width: 900px; margin: 0 auto; }

.sre-tabs { display: flex; gap: 4px; margin-bottom: 16px; border-bottom: 1px solid rgba(128,128,128,0.3); }

/* ? Help icon + tooltip for Sync vs Scrub */
.sre-h3-help { display: flex; align-items: center; gap: 8px; }
.sre-help {
    display: inline-flex; align-items: center; justify-content: center;
    width: 18px; height: 18px; border-radius: 50%;
    border: 1px solid rgba(128,128,128,0.6);
    font-size: 12px; font-weight: 700; cursor: help; user-select: none;
    line-height: 1; color: inherit;
}
.sre-help:hover { border-color: #ff8c2f; color: #ff8c2f; }
.sre-tooltip {
    display: none; position: fixed; z-index: 1000;
    max-width: 380px; width: auto;
    background: rgba(20,20,20,0.97); color: #eee;
    border: 1px solid rgba(255,255,255,0.2); border-radius: 8px;
    padding: 12px 14px; font-size: 13px; line-height: 1.5;
    box-shadow: 0 6px 20px rgba(0,0,0,0.5);
}
.sre-tooltip h4 { margin: 0 0 6px; font-size: 14px; }
.sre-tooltip p { margin: 0 0 6px; }
.sre-tooltip p:last-child { margin-bottom: 0; }
.sre-tab-btn {
    background: none; border: none; padding: 10px 18px; cursor: pointer;
    font-size: 14px; opacity: 0.7; border-bottom: 2px solid transparent;
}
.sre-tab-btn.active { opacity: 1; border-bottom: 2px solid #ff8c2f; font-weight: 600; }

.sre-card {
    background: rgba(128,128,128,0.08);
    border: 1px solid rgba(128,128,128,0.2);
    border-radius: 8px;
    padding: 16px 18px;
    margin-bottom: 14px;
}
.sre-card h3 { margin-top: 0; margin-bottom: 8px; }
.sre-hint { opacity: 0.75; font-size: 13px; margin-top: 0; }

.sre-row { display: flex; gap: 14px; }
.sre-row .sre-card { flex: 1; }

.sre-status-card {
    display: flex; align-items: center; gap: 14px;
    padding: 16px 18px; border-radius: 8px;
    background: rgba(128,128,128,0.08); margin-bottom: 14px;
}
.sre-status-light { width: 18px; height: 18px; border-radius: 50%; background: #888; flex-shrink: 0; }
.sre-status-light.ok { background: #4caf50; }
.sre-status-light.warn { background: #ffb300; }
.sre-status-light.error { background: #e53935; }
.sre-status-headline { font-size: 16px; font-weight: 600; }
.sre-status-sub { font-size: 13px; opacity: 0.7; }

.sre-btn {
    background: rgba(128,128,128,0.2); border: 1px solid rgba(128,128,128,0.3);
    color: inherit; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-size: 13px;
}
.sre-btn:hover { background: rgba(128,128,128,0.35); }
.sre-btn-primary { background: #ff8c2f; border-color: #ff8c2f; color: #111; font-weight: 600; }
.sre-btn-primary:hover { background: #ffa14f; }
.sre-btn-warn { background: #e53935; border-color: #e53935; color: #fff; }
.sre-btn-warn:hover { background: #ef5350; }
.sre-btn-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }

.sre-select, .sre-input, .sre-textarea {
    width: 100%; padding: 8px 10px; border-radius: 6px;
    border: 1px solid rgba(128,128,128,0.3); background: rgba(0,0,0,0.15); color: inherit;
    font-size: 13px; box-sizing: border-box;
}
.sre-textarea { min-height: 70px; margin-top: 8px; resize: vertical; }

.sre-checklist label { display: block; padding: 4px 0; font-size: 13px; }
.sre-checklist .sre-disk-size { opacity: 0.6; font-size: 12px; margin-left: 6px; }
.sre-alert-row {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    column-gap: 12px;
    padding: 5px 0;
    font-size: 13px;
}
.sre-alert-row label {
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
}
.sre-alert-row .sre-disk-size {
    display: flex;
    align-items: center;
    gap: 6px;
    opacity: 0.7;
    font-size: 12px;
}
.sre-alert-num { width: 60px; }

/* Custom schedule: day-of-week + time pickers */
#sre-custom-schedule .sre-hint { margin-top: 10px; }
.sre-custom-block { margin-top: 10px; padding: 10px 12px; background: rgba(128,128,128,0.08); border-radius: 6px; }
.sre-custom-label { display: block; font-weight: 600; font-size: 13px; }
.sre-dow-picker { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-top: 6px; }
.sre-dow-picker label { display: inline-flex; align-items: center; gap: 4px; font-size: 13px; }
.sre-custom-time { display: inline-flex; align-items: center; gap: 6px; margin-top: 8px; font-size: 13px; }
.sre-custom-time input[type=time] {
    background: rgba(0,0,0,0.15); border: 1px solid rgba(128,128,128,0.3); color: inherit;
    border-radius: 6px; padding: 4px 8px; font-size: 13px;
}
.sre-cron-preview { font-size: 12px; opacity: 0.75; margin-top: 6px; }
.sre-cron-preview code { background: rgba(0,0,0,0.3); padding: 1px 6px; border-radius: 4px; }
.sre-custom-advanced { display: block; margin-top: 10px; font-size: 13px; }

.sre-banner { padding: 12px 16px; border-radius: 6px; margin-bottom: 14px; font-size: 13px; }
.sre-banner-info { background: rgba(33,150,243,0.15); border: 1px solid rgba(33,150,243,0.4); }
.sre-banner-warn { background: rgba(255,179,0,0.15); border: 1px solid rgba(255,179,0,0.5); }

.sre-confirm { margin-top: 10px; padding: 10px; background: rgba(255,179,0,0.12); border-radius: 6px; }
.sre-confirm p { margin-top: 0; font-size: 13px; }
.sre-changes-modal { max-width: 900px; }
.sre-changes-scroll { flex: 1; overflow: auto; min-height: 0; margin-bottom: 8px; text-align: left; font-size: 12px; font-family: monospace; }
.sre-chg-head { font-weight: 600; margin: 4px 0; }
.sre-chg-removed { color: #e8a0a0; word-break: break-word; }
.sre-chg-added { color: #a0d8a0; word-break: break-word; }

.sre-log-list { font-size: 13px; }
.sre-log-entry { padding: 6px 0; border-bottom: 1px solid rgba(128,128,128,0.15); display: flex; justify-content: space-between; }
.sre-log-entry .sre-log-time { opacity: 0.6; font-size: 12px; }

.sre-problem-item {
    display: flex; justify-content: space-between; align-items: center;
    padding: 8px 0; border-bottom: 1px solid rgba(128,128,128,0.15); font-size: 13px;
}

.sre-problem-disks { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; }

/* History table + log modal */
.sre-history-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.sre-history-table th, .sre-history-table td { text-align: left; padding: 7px 9px; border-bottom: 1px solid rgba(128,128,128,0.15); }
.sre-history-table th { opacity: 0.7; font-weight: 600; }
.sre-history-table tbody tr.sre-hist-row { cursor: pointer; }
.sre-history-table tbody tr.sre-hist-row:hover { background: rgba(128,128,128,0.12); }
.sre-hist-ok td:first-child { border-left: 3px solid #6aa84f; }
.sre-hist-warn td:first-child { border-left: 3px solid #ffb84d; }
.sre-hist-bad td:first-child { border-left: 3px solid #e06666; }

.sre-log-modal { position: fixed; inset: 0; background: rgba(0,0,0,0.55); z-index: 1100; display: flex; align-items: center; justify-content: center; }
.sre-log-modal-box { background: #2a2a2a; border: 1px solid rgba(255,255,255,0.2); border-radius: 8px; max-width: 760px; width: 90%; max-height: 80vh; display: flex; flex-direction: column; padding: 14px 18px; }
.sre-log-modal-box h3 { margin: 0 0 8px; }
.sre-log-modal-box pre { background: rgba(0,0,0,0.4); border-radius: 6px; padding: 10px 12px; overflow: auto; flex: 1; font-size: 12px; font-family: monospace; white-space: pre-wrap; word-break: break-word; }
.sre-log-note { font-size: 12px; opacity: 0.7; margin-bottom: 8px; }
.sre-log-modal-box .sre-btn { align-self: flex-end; margin-top: 10px; }

#sre-setup-result { margin-left: 10px; font-size: 13px; }

/* Config backup list */
.sre-backup-list { margin-top: 10px; font-size: 13px; }
.sre-backup-item {
    display: flex; justify-content: space-between; align-items: center;
    padding: 8px 0; border-bottom: 1px solid rgba(128,128,128,0.15);
}
.sre-backup-actions { display: flex; gap: 6px; align-items: center; }
#sre-backup-result { margin-left: 10px; font-size: 13px; }
]]>
