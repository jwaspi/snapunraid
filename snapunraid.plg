  <!-- ============================= ALERTS =============================== -->
  <div class="sre-tab-panel" id="tab-alerts" style="display:none;">
    <div class="sre-card">
      <h3>Run notifications</h3>
      <p class="sre-hint">Choose which events send an Unraid notification. Delivery (email / agent / bell) is still controlled by Unraid's own notification settings.</p>
      <div class="sre-checklist" id="sre-alert-toggles">
        <label><input type="checkbox" data-alert="ALERT_SYNC_OK"> Sync completed successfully</label>
        <label><input type="checkbox" data-alert="ALERT_SYNC_ERROR"> Sync failed or was aborted</label>
