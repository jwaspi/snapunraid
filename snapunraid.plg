        <label><input type="checkbox" data-alert="ALERT_SCRUB_OK"> Scrub / full check completed with no problems</label>
        <label><input type="checkbox" data-alert="ALERT_SCRUB_ISSUES"> Scrub / full check found problems or failed</label>
        <label><input type="checkbox" data-alert="ALERT_RECOVER_OK"> Recovery completed</label>
        <label><input type="checkbox" data-alert="ALERT_RECOVER_ERROR"> Recovery failed or unrecoverable</label>
