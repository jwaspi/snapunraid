          <div class="sre-cron-preview">Cron: <code id="sre-scrub-cron-preview"></code></div>
        </div>

        <label class="sre-custom-advanced"><input type="checkbox" id="sre-custom-advanced"> Advanced: edit cron directly</label>
        <div id="sre-custom-advanced-box" style="display:none;">
          <label style="display:block;margin-top:8px;">Sync cron</label>
          <input type="text" id="sre-custom-sync-cron" class="sre-input" placeholder="30 3 * * 1,3,5">
          <label style="display:block;margin-top:8px;">Scrub cron</label>
          <input type="text" id="sre-custom-scrub-cron" class="sre-input" placeholder="0 4 * * 0">
        </div>
      </div>
    </div>

    <div class="sre-card">
      <h3>5. Safety threshold</h3>
      <p class="sre-hint">If a sync would remove or change more than this many files at once, pause and ask for confirmation instead of proceeding automatically. Protects against a dropped disk being mistaken for mass deletion. Optional — leave blank to use the default of 50.</p>
      <input type="number" id="sre-threshold-input" class="sre-input" value="<?=htmlspecialchars($cur_threshold)?>" min="1">
    </div>

    <button class="sre-btn sre-btn-primary" id="sre-btn-save-setup">Save Setup</button>
