<?xml version="1.0"?>
<!DOCTYPE PLUGIN [
  <!ENTITY name      "snapunraid">
  <!ENTITY author    "jwaspi">
  <!ENTITY version   "2026.10.09">
  <!ENTITY launch    "Settings/snapunraid">
  <!ENTITY pluginURL "https://raw.githubusercontent.com/jwaspi/snapunraid/main/snapunraid.plg">
  <!ENTITY support   "https://github.com/jwaspi/snapunraid/issues">
]>
<PLUGIN name="snapunraid" version="&version;" author="&author;" icon="camera"
        pluginURL="&pluginURL;" support="&support;" launch="&launch;">
  <CHANGES><![CDATA[
2026.10.09 - FIX: after a reboot the Dashboard reported "Last sync: never", "No sync/scrub run yet" and "No activity yet" even though the History tab still listed past runs. The runtime state lives in a tmpfs file wiped on reboot; the Dashboard's last-run summary is now rebuilt from the persistent history on first load.
2026.10.06 - SnapRAID updates: the Setup tab now shows the installed and latest SnapRAID versions and offers an Update button when a newer release is available (checked against GitHub, cached 6h). Fresh installs bootstrap to the latest release; a pinned version is used only if GitHub is unreachable.
2026.10.05 - FIX: "Scrub is overdue" no longer false-alarms on a healthy, recently-scrubbed array. It now warns only when no scrub has completed within the threshold, not when a single block's age (scrub_oldest_days) exceeds it.
2026.09.29 - Audit fixes: Restore/Check wait for snapraid's lock; an empty exclude list is honored; Save Setup reports real failures; Recover uses the newest detection run; cancellation is safer; run-log tails persist across a reboot. Added an offline test suite.
2026.09.28 - FIX: Recover listed wrong paths and could not restore files (disk labels differ from mount names; single-file fix needs a relative filter). Bad-file counts now report unique files, not blocks. Settings values containing & or | no longer corrupt settings.ini. Faster, bounded check parsing.
2026.09.26 - FIX: the sync/scrub/health-check schedule did not survive a reboot. The event/started hook now reinstalls cron from settings.ini at boot and is shipped executable, so the array stays protected after a restart.
2026.09.14 - Dashboard: a scrub that only flagged files deleted since the last sync shows "Sync needed" instead of "Attention needed", cleared by the next successful sync.
2026.09.13 - Recover: files deleted since the last sync are labeled and no longer offered for restore (run a Sync instead); also fixes the tab hanging on very large error counts.
2026.09.11 - FIX: sync/scrub/check now wait for any in-flight snapraid command to release its lock, avoiding "SnapRAID is already in use!".
2026.09.09a - Config Backups: added a Delete button.
2026.09.09 - Setup: a disk chosen as parity is hidden from the protect list so it can't be assigned to both.
2026.09.08 - FIX: cron entries used a "root" column Unraid's crond rejects, so every scheduled run silently failed; entries are now 5-field.
2026.09.06 - FIX: cron runs failed with "snapraid binary not found" because crond's PATH omits /usr/local/sbin; common.sh now adds it.
2026.09.05 - Initial public release.
  ]]>
  </CHANGES>

  <FILE Run="/bin/bash">
  <INLINE>
<![CDATA[
# Pre-install cleanup. This was previously a bare top-level
# <RUN command="rm -rf ..."/> (plus two mkdir) at the start of the plugin, but
# Unraid's installer only processes <FILE> elements and silently ignores
# top-level <RUN>, so those never ran. Keeping it as the first FILE element
# preserves the original ordering: clean the old tree, then let the following
# FILE blocks repopulate it.
rm -rf /usr/local/emhttp/plugins/snapunraid
mkdir -p /usr/local/emhttp/plugins/snapunraid/scripts
mkdir -p /usr/local/emhttp/plugins/snapunraid/images
]]>
  </INLINE>
  </FILE>

  <FILE Name="/usr/local/emhttp/plugins/snapunraid/snapunraid.page">
  <INLINE>
<![CDATA[Menu="Utilities"
Title="SnapUnraid"
Icon="camera"
---
<?php
/*
 * SnapUnraid - friendly front-end for SnapRAID on Unraid
 * Tabs: Setup / Dashboard / Recover
 *
 * NOTE: AJAX/POST handling does NOT live here. Unraid's nginx returns 405
 * Not Allowed for POST to .page files, so all front-end post() requests go to
 * /plugins/snapunraid/ajax.php. This file only renders the page HTML.
 */

$plugin      = 'snapunraid';
$scriptDir   = '/usr/local/emhttp/plugins/' . $plugin . '/scripts';
$settingsIni = '/boot/config/plugins/' . $plugin . '/settings.ini';
// ---------------------------------------------------------------------------
// Load current settings for pre-filling the Setup form
// ---------------------------------------------------------------------------
// Read a settings.ini value. A key that is present with an empty value returns
// '' (NOT the default) - the default applies only when the key is absent. That
// is what lets list-like settings such as EXCLUDES represent "the user cleared
// every exclude"; scalar callers pass a sensible default for the absent case.
function sre_ini_get($key, $default = '') {
    global $settingsIni;
    if (!file_exists($settingsIni)) return $default;
    foreach (file($settingsIni) as $line) {
        if (strpos($line, "{$key}=") === 0) {
            return trim(substr($line, strlen($key) + 1));
        }
    }
    return $default;
}

$cur_parity   = sre_ini_get('PARITY_PATH', '');
$cur_data     = sre_ini_get('DATA_DISKS', '');
$cur_content  = sre_ini_get('CONTENT_DISKS', '');
$cur_excludes = sre_ini_get('EXCLUDES', '*.tmp,*.bak,/appdata/,/system/,/domains/,/isos/,downloads/incomplete/');
$cur_schedule = sre_ini_get('SCHEDULE', 'daily');
$cur_custom_sync = sre_ini_get('CUSTOM_SYNC_CRON', '30 3 * * 1,3,5');
$cur_custom_scrub = sre_ini_get('CUSTOM_SCRUB_CRON', '0 4 * * 0');
$cur_threshold= sre_ini_get('DELETE_THRESHOLD_COUNT', '50');
$alertDefaults = [
    'ALERT_SYNC_OK' => '0', 'ALERT_SYNC_ERROR' => '1', 'ALERT_SYNC_CONFIRM' => '1',
    'ALERT_SCRUB_OK' => '0', 'ALERT_SCRUB_ISSUES' => '1',
    'ALERT_RECOVER_OK' => '0', 'ALERT_RECOVER_ERROR' => '1', 'ALERT_CANCELLED' => '0',
    'ALERT_PARITY_STALE' => '1', 'ALERT_DISK_OFFLINE' => '1',
    'ALERT_PARITY_SPACE' => '1', 'ALERT_SCRUB_OVERDUE' => '1',
    'ALERT_CONTENT_STALE' => '1', 'ALERT_PARITY_MISSING' => '1', 'ALERT_UNRECOVERED' => '1',
    'ALERT_PARITY_STALE_DAYS' => '30', 'ALERT_PARITY_SPACE_PCT' => '10', 'ALERT_SCRUB_OVERDUE_DAYS' => '30',
];
$cur_alerts = [];
foreach ($alertDefaults as $k => $def) { $cur_alerts[$k] = sre_ini_get($k, $def); }
$is_configured = !empty($cur_parity) && !empty($cur_data);

// Auto-detect an existing snapraid.conf (from the old snapraid plugin, a
// manual /etc install, etc.) so the Setup tab can offer to import it.
$importCandidates = [
    '/boot/config/plugins/snapraid/snapraid.conf',
    '/etc/snapraid.conf',
    '/boot/config/snapraid.conf',
];
$importDetected = '';
foreach ($importCandidates as $c) { if (file_exists($c)) { $importDetected = $c; break; } }
?>

