        <option value="manual">Manual only (no automatic schedule)</option>
      </select>
      <div id="sre-custom-schedule" style="display:none;">
        <p class="sre-hint">Pick the days and times for sync and scrub. The daily 3:15am health check always runs.</p>

        <div class="sre-custom-block">
          <label class="sre-custom-label">Sync</label>
          <div class="sre-dow-picker" id="sre-sync-dow">
