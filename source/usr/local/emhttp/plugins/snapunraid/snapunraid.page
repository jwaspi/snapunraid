$settingsIni = '/boot/config/plugins/' . $plugin . '/settings.ini';
// ---------------------------------------------------------------------------
// Load current settings for pre-filling the Setup form
// ---------------------------------------------------------------------------
function sre_ini_get($key, $default = '') {
    global $settingsIni;
    if (!file_exists($settingsIni)) return $default;
    foreach (file($settingsIni) as $line) {
        if (strpos($line, "{$key}=") === 0) {
            return trim(substr($line, strlen($key) + 1));
        }
    }
    return $default;
}

